<?xml version="1.0" encoding="utf-8"?>
<!--
    権限は必要になったマイルストーンで追加する（PLAN §5）。INTERNET・位置情報・CAMERA・VIBRATE・
    SCHEDULE_EXACT_ALARM は使わない方針のため宣言しない。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 音声入力（F-01）。初めてマイクボタンを押した時に求め、拒否されても文字入力で全機能が使える -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 11 以降は音声認識サービスを見つけるために宣言が必要（無いと「使えない」と判定される、PLAN §4.1） -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".IkumemoApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ikumemo">
        <!-- カメラアプリへ撮影先の一時ファイルを渡すため（CAMERA 権限は宣言しない、PLAN §5） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
