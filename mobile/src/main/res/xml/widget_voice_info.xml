<?xml version="1.0" encoding="utf-8"?>
<!-- W-01 話して追加。1×1（サイズ変更は 1×1〜2×2）。API 31 未満は max*/target*/previewLayout を無視し、previewImage を使う -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_voice_picker_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="130dp"
    android:maxResizeHeight="130dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_voice_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
