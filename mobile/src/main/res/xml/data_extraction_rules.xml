<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降のバックアップの対象（F-71、PLAN §4.3）。
  クラウド（Google ドライブ）は 1 アプリ 25MB を超えると全体が止まるため、写真（filesDir/photos/）だけ外す。
  DB（ikumemo.db）・設定（DataStore）・背景画像は残す。機種変更の端末間転送は容量の制限が無いため、写真も含めて全部を移す。
  include を書かない区分は、外したもの以外の全部が対象になる（キャッシュのカメラの一時ファイルはもともと対象外）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="photos/" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
